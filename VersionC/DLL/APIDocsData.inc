	{ 286, "30005, [double], Circuit.AllBusVMag, This parameter returns a pointer to an array of doubles with the node voltages from the most recent solution." },
	{ 287, "30006, [str], Circuit.AllElementNames, This parameter returns a pointer to an array of strings with the names of all the elements of the active circuit. The names of the elements are separated by a NULL (0) character." },
