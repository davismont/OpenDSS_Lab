	{ 1276, "147000, int, CtrlQueue.ClearQueue, This parameter clears the control queue." },
	{ 1277, "147001, int, CtrlQueue.Delete, This parameter deletes a control action from the DSS control queue by referencing the handle of the action (Argument)." },
	{ 1278, "147002, int, CtrlQueue.NumActions, This parameter gets the number of actions on the current action list (that have been popped off the control queue by CheckControlActions)." },
	{ 1279, "147003, int, CtrlQueue.Action, This parameter sets the active action by index (argument)." },
	{ 1280, "147004, int, CtrlQueue.ActionCode, This parameter gets the code for the active action. Long integer code to tell the control device what to do." },
	{ 1281, "147005, int, CtrlQueue.DeviceHandle, This parameter gets the handle (user defined) to device that must act on the pending action." },
